#!/bin/bash
# =============================================================
# run_uvm_simulation — Alias for run_simulation
# =============================================================

if [ -d "work" ]; then vdel -all -lib work; fi
vlib work

# Run ModelSim in batch mode using the UVM do file
# This script fulfills the requirement to:
# 1. Create work library
# 2. Compile SV and UVM files
# 3. Run vsim on UVM module
# 4. Compare outputs and report results
vsim -do fm_uvm_sim.do

